# =====================================================================
# NotGoogle Environment Configuration
# =====================================================================

# PostgreSQL Database Connection String
# Can point to local PostgreSQL or Neon Cloud PostgreSQL with pgvector extension
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/notgoogle

# SearXNG Metasearch Service URL (running via docker-compose)
SEARXNG_URL=http://localhost:8080

# LLM Provider & Model for AI Overview (LiteLLM format)
# Supported: gemini/gemini-2.5-flash, groq/llama-3.3-70b-versatile, gpt-4o-mini, ollama/llama3
LLM_MODEL=gemini/gemini-2.5-flash

# API Key for chosen LLM provider (e.g. GEMINI_API_KEY, GROQ_API_KEY, OPENAI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
